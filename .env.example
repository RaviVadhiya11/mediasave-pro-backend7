PORT=3000
ALLOWED_ORIGINS=https://vivadhiya11.github.io,https://ravivadhiya11.github.io,http://localhost:3000

# Meta Unified Login / Business Integration System User Token.
# Put the real token only in Render Environment. Never commit it to GitHub.
INSTAGRAM_API_MODE=unified
INSTAGRAM_ACCESS_TOKEN=replace_with_your_system_user_access_token
INSTAGRAM_USER_ID=17841430415668153
INSTAGRAM_GRAPH_VERSION=v27.0

# For Instagram Login tokens instead, set INSTAGRAM_API_MODE=instagram_login.
# Do not mix token types and API hosts.

# Owner-only protection for /api/instagram/media. Set a unique random secret in Render.
MEDIA_ACCESS_KEY=replace_with_a_long_random_private_key
